NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

# Local PostgreSQL started by `docker compose up -d postgres`. Keep these in step with DATABASE_URL.
POSTGRES_DB=woko
POSTGRES_USER=woko
POSTGRES_PASSWORD=woko
POSTGRES_PORT=5433
DATABASE_URL=postgres://woko:woko@localhost:5433/woko

# `test` signs everyone in as one local user (see README), `google` uses Google Workspace.
# `test` is refused when NODE_ENV=production.
AUTH_MODE=test
ALLOWED_GOOGLE_DOMAIN=millennia21.id

# Fill these in for AUTH_MODE=google. An empty value is rejected, so leave a key out until you have its value.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_SHARED_DRIVE_ID=
# GOOGLE_WORK_ORDERS_ROOT_FOLDER_ID=
# GOOGLE_PICKER_API_KEY=
# GOOGLE_PICKER_APP_ID=

APP_TIME_ZONE=Asia/Jakarta
# Same-origin through the Vite proxy, which follows PORT above.
VITE_API_URL=/api/v1

# Central (Access Standard). Only `npm run permissions:sync` and `permissions:check` read these.
# CENTRAL_API_BASE_URL=https://central.example.org
# CENTRAL_API_TOKEN=
# CENTRAL_APPLICATION_ID=woko
