NODE_ENV=development
# Dev ports are listed in the MWS dev ports registry: Woko web 5177, API 3011.
PORT=3011
WEB_ORIGIN=http://localhost:5177
APP_BASE_URL=http://localhost:5177

# Local PostgreSQL started by `docker compose up -d postgres`. Keep these in step with DATABASE_URL.
POSTGRES_DB=woko
POSTGRES_USER=woko
POSTGRES_PASSWORD=woko
POSTGRES_PORT=5433
DATABASE_URL=postgres://woko:woko@localhost:5433/woko

# `test` signs everyone in as one local user (see README), `google` uses Google Workspace, `hub` signs in through the
# MWS Hub and takes what a person may do from Central. `test` is refused when NODE_ENV=production.
AUTH_MODE=test
ALLOWED_GOOGLE_DOMAIN=millennia21.id

# Fill these in for AUTH_MODE=google. An empty value is rejected, so leave a key out until you have its value.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_SHARED_DRIVE_ID=
# GOOGLE_WORK_ORDERS_ROOT_FOLDER_ID=
# GOOGLE_PICKER_API_KEY=
# GOOGLE_PICKER_APP_ID=

APP_TIME_ZONE=Asia/Jakarta
# Same-origin through the Vite proxy, which follows PORT above.
VITE_API_URL=/api/v1

# Central (Access Standard). `permissions:sync` and `permissions:check` read the first three. AUTH_MODE=hub needs all of them
# plus HUB_BASE_URL and CENTRAL_ORGANIZATION_ID.
# CENTRAL_API_BASE_URL=https://central.example.org
# CENTRAL_API_TOKEN=
# CENTRAL_APPLICATION_ID=woko

# AUTH_MODE=hub only. Woko must be on a subdomain of the Hub's parent domain so it can read the shared session cookie.
# HUB_BASE_URL=https://hub.example.org
# HUB_ACCESS_COOKIE_NAME=
# CENTRAL_ORGANIZATION_ID=
# Minutes between copies of Central's entitlements into the local user list (default 5).
# CENTRAL_SYNC_INTERVAL_MINUTES=5
