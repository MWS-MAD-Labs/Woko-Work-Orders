{
  "name": "@woko/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build -w @woko/domain && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build -w @woko/domain && vitest run --passWithNoTests",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:seed": "tsx src/database/seed.ts",
    "notifications:preview": "tsx src/scripts/send-notification-previews.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@woko/domain": "*",
    "dotenv": "^16.5.0",
    "fastify": "^5.4.0",
    "file-type": "^21.3.4",
    "google-auth-library": "^10.9.0",
    "googleapis": "^173.0.0",
    "postgres": "^3.4.7",
    "sharp": "^0.35.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.32",
    "tsx": "^4.20.3"
  }
}
