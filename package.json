{
  "name": "woko",
  "version": "0.6.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @woko/api\" \"npm run dev -w @woko/web\"",
    "build": "npm run build -w @woko/domain && npm run build -w @woko/api && npm run build -w @woko/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @woko/api",
    "db:seed": "npm run db:seed -w @woko/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
